{
  "name": "sharpit",
  "private": true,
  "packageManager": "yarn@4.14.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test -- --maxWorkers=4",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web": "yarn workspace @sharpit/web",
    "api": "yarn workspace @sharpit/api",
    "hub": "yarn workspace @sharpit/hub",
    "core": "yarn workspace @sharpit/core",
    "prepare": "node -e \"process.exit(process.env.CI||process.env.VERCEL?0:1)\" || husky",
    "check:text-colors": "node scripts/ci/check-hardcoded-text-colors.mjs"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.11.4"
  },
  "lint-staged": {
    "*.{json,css,scss,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  }
}
