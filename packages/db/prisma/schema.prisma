generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ActivityType {
  RUN
  BIKE
  SWIM
  STRENGTH
  TRIATHLON
  HIKE
  OTHER
}

enum GoalHorizon {
  LONG_TERM
  MEDIUM_TERM
  SHORT_TERM
  WEEKLY
  MONTHLY
  YEARLY
}

enum GoalKind {
  RACE
  METRIC
}

// Priorité d'une course (standard triathlon) :
// A = objectif principal de la saison, B = course intermédiaire, C = test / entraînement.
enum GoalPriority {
  A
  B
  C
}

enum SessionIntensity {
  RECOVERY
  ENDURANCE
  TEMPO
  THRESHOLD
  VO2MAX
  RACE
}

enum PhysicalCategory {
  PAIN // douleur
  INJURY // blessure
  MOBILITY // mobilité / souplesse
  POSTURE // posture / déséquilibre (bassin, pieds...)
  OTHER
}

enum BodySide {
  LEFT
  RIGHT
  BILATERAL
  NA
}

enum PhysicalStatus {
  ACTIVE // en cours
  MONITORING // sous surveillance
  RESOLVED // résolue
}

// ─── Physical Health Engine (Phase 1) ───────────────────────────────────────

enum ConditionScope {
  LOCALIZED
  SYSTEMIC
}

enum ConditionType {
  PAIN
  INJURY
  DISCOMFORT
  MOBILITY_LIMITATION
  POSTURE_ISSUE
  MUSCULAR_TIGHTNESS
  JOINT_STIFFNESS
  INSTABILITY
  RECURRING_PHYSICAL
  OTHER
}

enum ConditionStatus {
  NEW
  ACTIVE
  IMPROVING
  STABLE
  WORSENING
  RESOLVED
  RECURRENT
}

enum EpisodeStatus {
  ACTIVE
  IMPROVING
  STABLE
  WORSENING
  RESOLVED
}

enum ObservationContext {
  BEFORE_SESSION
  DURING_SESSION
  AFTER_SESSION
  MORNING_CHECKIN
  EVENING_CHECKIN
  MANUAL
  COACH_CONVERSATION
  INTEGRATION
  LEGACY_MIGRATION
}

enum ObservationSource {
  ATHLETE
  COACH_AI
  SYSTEM_MIGRATION
  INTEGRATION
}

enum FunctionalImpact {
  NONE
  MILD
  MODERATE
  LIMITING
  STOPPED
}

enum TrainingCapacityLevel {
  FULL
  REDUCED
  LIMITED
  UNABLE
}

enum KnowledgeHypothesisType {
  TRIGGER
  RECOVERY_DURATION
  RECURRENCE_PATTERN
  OTHER
}

enum KnowledgeConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum PlanPhase {
  BASE
  BUILD
  PEAK
  TAPER
  RACE
}

enum TrainingPlanStatus {
  ACTIVE
  ARCHIVED
}

model Activity {
  id       String       @id @default(cuid())
  type     ActivityType
  date     DateTime
  title    String?
  duration Int?
  rpe      Int?
  feeling  String?
  notes    String?
  weather  String?
  load     Float?

  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  source   String  @default("manual") // manual | garmin | strava | both
  stravaId String? @unique
  garminId String? @unique

  /// Jambes et transitions d'un multisport Garmin (natation, T1, vélo, T2, course…)
  multisportLegs Json?

  runMetrics            RunMetrics?
  bikeMetrics           BikeMetrics?
  swimMetrics           SwimMetrics?
  hikeMetrics           HikeMetrics?
  hikeTripId            String?
  hikeTrip              HikeTrip?              @relation(fields: [hikeTripId], references: [id], onDelete: SetNull)
  strengthSets          StrengthSet[]
  stream                ActivityStream?
  plannedSession        PlannedSession?
  goalAchievements      GoalAchievement[]
  conditionObservations ConditionObservation[]

  /// Analyse narrative coach (figée une fois générée)
  narrativeAnalysis   Json?
  narrativeAnalyzedAt DateTime?

  /// Lieu observé (reverse geocode GPS après séance)
  observedLocationLabel String?
  observedLocationLat   Float?
  observedLocationLng   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([type])
  @@index([hikeTripId])
  @@index([athleteId])
}

enum AccessTier {
  FREE
  PRO
}

/// Where a SharpIt Pro entitlement comes from (ADR-044). `manual` is the /admin toggle.
enum SubscriptionSource {
  apple
  stripe
  manual
}

/// Only `active` and `grace_period` grant Pro (`subscriptionGrantsPro`).
enum SubscriptionStatus {
  active
  grace_period
  billing_retry
  expired
  revoked
}

/// Declared by the athlete in Paramètres → Compte. Biological age and HR norms depend on it.
enum AthleteSex {
  female
  male
  other
}

model AthleteProfile {
  id                       String     @id @default(cuid())
  clerkUserId              String     @unique
  /// Palier d'accès — dérivé des abonnements (`Subscription`, ADR-044) : jamais écrit
  /// ailleurs que par `recomputeAthleteTier`. La bascule /admin passe par un abonnement `manual`.
  tier                     AccessTier @default(FREE)
  /// UUID stable remis à StoreKit (`appAccountToken`) : relie un achat Apple à ce compte.
  appAccountToken          String?    @unique
  heightCm                 Int? // taille (cm) — comparaisons composition (IMC, etc.)
  /// Optional body-weight target (kg) — read by the nutrition day analysis, never by Core.
  targetWeightKg           Float?
  /// The athlete's own daily intake targets for the in-app food log (ADR-061). Null = not set.
  nutritionTargetKcal      Int?
  nutritionTargetProteinG  Float?
  nutritionTargetCarbsG    Float?
  nutritionTargetFatG      Float?
  /// PERCENT: the macro targets split `nutritionTargetKcal`; the grams above follow the split.
  nutritionTargetMode      NutritionTargetMode @default(GRAMS)
  nutritionTargetProteinPct Int?
  nutritionTargetCarbsPct  Int?
  nutritionTargetFatPct    Int?
  birthDate                DateTime?  @db.Date // date de naissance — âge calculé dynamiquement
  sex                      AthleteSex?
  ftpW                     Int? // FTP vélo (W)
  maxHr                    Int? // FC max (bpm)
  lthr                     Int? // FC seuil lactique (bpm)
  runThresholdPaceSecPerKm Float? // allure seuil (s/km)
  swimCssSecPer100m        Float? // vitesse critique natation (s/100m)
  vo2maxRunning            Int? // VO2max course
  vo2maxCycling            Int? // VO2max vélo
  thresholdsSyncedAt       DateTime? // dernier import depuis Garmin

  context String? @db.Text // contexte libre éditable (dispos, contraintes pro, préférences) injecté dans le coach IA

  /// Densité de lecture choisie par l'athlète : 'essential' | 'expert'.
  /// 'expert' déverrouille les métriques techniques (TSS, IF, CTL/ATL/TSB, seuils…).
  displayMode String @default("essential")

  /// Journal module visibility + diet + auto-checklist thresholds.
  /// Shape: JournalPrefs v1 — see src/lib/health/journal-prefs.ts
  journalPrefs Json?

  /// Capability inventory for session generation (home trainer, fins, gym membership…).
  /// Shape: { version: 1, strengthVenue: 'gym'|'home'|'both'|'bodyweight'|null, owned: string[] }
  equipment Json?

  /// Endurance-first practiced sports catalog.
  /// Shape: { version: 1, sports: ('run'|'bike'|'swim'|'triathlon'|'strength'|'mobility'|'stretching')[] }
  /// Null = treat as all core sports on read (existing athletes).
  practicedSports Json?

  /// Declared training rhythm — sessions wanted per week and days free to train.
  /// Shape: { version: 1, targetSessionsPerWeek: number|null, availableWeekdays: (0-6)[] }
  /// Weekdays follow `Date#getDay` (0 = Sunday). Null = never declared; the coach
  /// then reads only the days observed from past activities.
  trainingAvailability Json?

  /// Longueur du bassin habituel (m) — Garmin en a besoin pour rendre une séance
  /// de natation en piscine. Surchargeable séance par séance.
  defaultPoolLengthM Int?

  sleepTargetMinutes    Int? // durée de sommeil visée (min)
  sleepBedtimeTargetMin Int? // heure de coucher visée (minutes depuis minuit, locale)

  homeLocationLabel String?
  homeLocationLat   Float?
  homeLocationLng   Float?

  /// First-login wizard finished (sports + intention + optional providers). Null = must complete onboarding.
  onboardingCompletedAt DateTime?

  /// Privacy mini V0 — legal + processing consents (null = not yet accepted).
  /// Field names map to product snake_case: terms_accepted_at, privacy_accepted_at,
  /// privacy_version, health_data_consent_at, ai_processing_consent_at,
  /// unofficial_providers_ack_at. Soft-delete: deletedAt; purge after 30 days via cron.
  termsAcceptedAt          DateTime?
  privacyAcceptedAt        DateTime?
  privacyVersion           String?
  healthDataConsentAt      DateTime?
  aiProcessingConsentAt    DateTime?
  unofficialProvidersAckAt DateTime?
  /// Soft-delete marker. Hard purge after PRIVACY_PURGE_DELAY_DAYS (see src/lib/privacy).
  deletedAt DateTime?

  /// Per data-class source preferences: primary + enabled providers (ADR-027).
  /// Shape: { version: 1, classes: { activities: { primary, enabled }, ... } }
  integrationSourcePrefs Json?

  /// Which pushes the athlete wants. Shape: NotificationPrefs v1 — see
  /// src/lib/notifications/notification-prefs.ts. Null = server defaults.
  notificationPrefs Json?
  /// Which parts of SharpIt the athlete uses (pages, Résumé cards, widgets). Shape:
  /// FeaturePrefs v1 — see packages/server/src/lib/features/feature-prefs.ts. Null = all on.
  featurePrefs Json?
  /// Apple Health linked from the iPhone app — its « connection », there being no account (ADR-054).
  appleHealthLinkedAt DateTime?

  /// Date (YYYY-MM-DD) of the last morning verdict push sent to this athlete.
  /// Prevents duplicate morning pushes across cron runs (silence over noise).
  lastMorningPushDate String?

  /// APNs device tokens for native push notifications (SHARPIT-APP).
  deviceTokens DeviceToken[]
  feedback     AthleteFeedback[]

  /// SharpIt Pro entitlements (Apple, Stripe, manual) — `tier` is derived from them.
  subscriptions Subscription[]

  thresholdSnapshots AthleteThresholdSnapshot[]

  // Tenant back-relations — multi-tenant conversion (ADR-025). Root data:
  activities                  Activity[]
  dailyNutrition              DailyNutrition[]
  nutritionDayAnalyses        NutritionDayAnalysis[]
  analysisRuns                AnalysisRun[]
  hikeTrips                   HikeTrip[]
  dailyHealth                 DailyHealth[]
  bodyCompositionMeasurements BodyCompositionMeasurement[]
  goals                       Goal[]
  trainingPlans               TrainingPlan[]
  physicalNotes               PhysicalNote[]
  conditions                  Condition[]
  conditionObservations       ConditionObservation[]
  dailyBriefings              DailyBriefing[]
  weeklyReviews               WeeklyReview[]
  performanceRecords          PerformanceRecord[]
  conversations               Conversation[]
  plannedSessions             PlannedSession[]
  travelContexts              AthleteTravelContext[]
  dayJournals                 AthleteDayJournal[]
  journalHabitExperiments     JournalHabitExperiment[]
  activityStatus              AthleteActivityStatus?
  activityStatusHistory       AthleteActivityStatusHistory[]
  brickAnalyses               BrickAnalysis[]
  brickEvaluations            BrickEvaluation[]
  analysisEvidenceSnapshots   AnalysisEvidenceSnapshot[]
  // Integration accounts (one row per provider per athlete):
  garminAccount               GarminAccount?
  stravaAccount               StravaAccount?
  googleAccount               GoogleAccount?
  renphoAccount               RenphoAccount?
  withingsAccount             WithingsAccount?
  myFitnessPalAccount         MyFitnessPalAccount?
  foodLogEntries              FoodLogEntry[]
  customFoods                 FoodProduct[]
  // Core / Inference layer (already athlete-scoped, gaining the FK only):
  observations                Observation[]
  featureSets                 FeatureSet[]
  digitalTwin                 DigitalTwin?
  environmentalObservations   EnvironmentalObservationRecord[]
  decisionRecords             DecisionRecord[]
  coachingDecisions           CoachingDecision[]
  snapshotRecords             AthleteSnapshotRecord[]
  aiUsageEvents               AiUsageEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
}

/// APNs device token registered by the native iOS client (SHARPIT-APP).
/// Multiple devices per athlete are supported; tokens are deactivated on APNs 410.
/// One SharpIt Pro entitlement. Apple rows are keyed by `originalTransactionId`, which
/// stays the same across renewals; the manual row is one per athlete (/admin).
model Subscription {
  id                    String             @id @default(cuid())
  athleteId             String
  athlete               AthleteProfile     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  source                SubscriptionSource
  productId             String
  originalTransactionId String?            @unique
  status                SubscriptionStatus
  expiresAt             DateTime?
  willRenew             Boolean            @default(false)
  /// App Store environment (`Production` | `Sandbox`), null for other sources.
  environment           String?
  appAccountToken       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteId])
}

/// What an athlete wrote through « Donner un avis » in the app — the beta's voice. Their own words,
/// exported with their data and deleted with their account.
model AthleteFeedback {
  id         String         @id @default(cuid())
  athleteId  String
  athlete    AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  message    String
  /// Where it was written from: `settings`, `activity`…
  context    String?
  /// The app's version and build, e.g. `1.0 (202610041900)`.
  appVersion String?
  createdAt  DateTime       @default(now())

  @@index([athleteId, createdAt])
}

model DeviceToken {
  id         String         @id @default(cuid())
  athleteId  String
  athlete    AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  token      String         @unique
  platform   String         @default("ios")
  bundleId   String         @default("app.sharpit.ios")
  /// APNs environment the token belongs to: `production` (TestFlight, App Store) or `sandbox`
  /// (a build run from Xcode). Apple refuses a token sent to the other one.
  environment String        @default("production")
  enabled    Boolean        @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([athleteId])
  @@index([token])
}

model AthleteThresholdSnapshot {
  id                       String         @id @default(cuid())
  profileId                String
  profile                  AthleteProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  source                   String // estimated | garmin | manual
  ftpW                     Int?
  lthr                     Int?
  runThresholdPaceSecPerKm Float?
  swimCssSecPer100m        Float?

  createdAt DateTime @default(now())

  @@index([profileId])
  @@index([createdAt])
}

model ActivityStream {
  id         String   @id @default(cuid())
  activityId String   @unique
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  available Boolean @default(false) // false = pas de GPS/streams (manuel, piscine, erreur définitive)
  polyline  String? // polyline encodée (fallback carte)
  data      Json? // séries temporelles : { time, distance, altitude, heartrate, watts, cadence, velocity, latlng }

  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GarminAccount {
  athleteId          String         @id
  athlete            AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  displayName        String?
  fullName           String?
  /// AES-256-GCM encrypted JSON (secret-box.ts) — never stored in plain Json.
  oauth1TokenEnc     String
  oauth2TokenEnc     String
  lastSyncAt         DateTime?
  lastActivitySyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StravaAccount {
  athleteId       String         @id
  athlete         AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  /// Strava's own external athlete id — unrelated to the tenant `athleteId` PK above.
  stravaAthleteId String         @unique
  firstName       String?
  lastName        String?
  avatarUrl       String?
  /// AES-256-GCM encrypted (secret-box.ts).
  accessTokenEnc  String
  refreshTokenEnc String
  expiresAt       DateTime
  scope           String?
  lastSyncAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GoogleAccount {
  athleteId       String         @id
  athlete         AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  email           String?
  /// AES-256-GCM encrypted (secret-box.ts).
  accessTokenEnc  String
  refreshTokenEnc String
  expiresAt       DateTime
  scope           String?

  // Calendrier cible où le coach écrit les séances (ex: calendrier "SPORT")
  targetCalendarId   String?
  targetCalendarName String?
  // Calendriers Google masqués dans la page Calendrier de l'app
  hiddenCalendarIds  String[] @default([])
  // Fuseau horaire utilisé pour créer les événements
  timeZone           String   @default("Europe/Paris")

  lastSyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RenphoAccount {
  athleteId    String         @id
  athlete      AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  email        String
  passwordEnc  String
  displayName  String?
  renphoUserId String?
  lastSyncAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WithingsAccount {
  athleteId       String         @id
  athlete         AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  withingsUserId  String
  /// AES-256-GCM encrypted (secret-box.ts).
  accessTokenEnc  String
  refreshTokenEnc String
  expiresAt       DateTime
  displayName     String?
  lastSyncAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MyFitnessPalAccount {
  athleteId       String         @id
  athlete         AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  sessionTokenEnc String
  displayName     String?
  lastSyncAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Coach reading of one logged nutrition day (docs/product/NUTRITION_DAY_ANALYSIS.md, ADR-035).
/// Advisory only — never read by Core, the snapshot or the Decision Engine.
model NutritionDayAnalysis {
  id        String                  @id @default(cuid())
  athleteId String
  athlete   AthleteProfile          @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  /// Training day, stored at UTC midnight like DailyNutrition.date.
  date      DateTime
  status    NutritionAnalysisStatus @default(FINAL)

  /// Hash of the facts the stored analysis was generated from. A different current hash means stale.
  inputHash   String?
  facts       Json?
  analysis    Json?
  model       String?
  generatedAt DateTime?

  /// Last generation claim — dedupes concurrent requests and throttles retries after a failure.
  attemptHash String?
  attemptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([athleteId, date])
}

enum NutritionAnalysisStatus {
  PROVISIONAL
  FINAL
}

/// A food the log can reference (ADR-061): a cached Open Food Facts product (`source: OFF`,
/// `barcode` set, shared by every athlete) or an athlete's own food (`source: CUSTOM`, `ownerId`).
/// Nutrients are per 100 g; a serving, when known, says how many grams one portion weighs.
model FoodProduct {
  id             String            @id @default(cuid())
  source         FoodProductSource
  barcode        String?           @unique
  /// ANSES Ciqual food code, for a generic food (ADR-065).
  ciqualCode     Int?              @unique
  ownerId        String?
  owner          AthleteProfile?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  brand          String?
  kcalPer100g    Float
  proteinPer100g Float
  carbsPer100g   Float
  fatPer100g     Float
  fiberPer100g         Float?
  sugarPer100g         Float?
  saltPer100g          Float?
  saturatedFatPer100g  Float?
  servingGrams         Float?
  servingLabel         String?
  /// Sharpit health score snapshot (`FoodHealthAssessment`); null when not yet computed.
  health               Json?
  /// Open Food Facts only: why the product is trusted beyond the crowd (ADR-069); null when not.
  verification         FoodVerification?
  fetchedAt            DateTime          @default(now())

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  entries   FoodLogEntry[]

  @@index([ownerId])
}

enum NutritionTargetMode {
  GRAMS
  PERCENT
}

/// Open Food Facts product data given by the manufacturer, or checked by a moderator (ADR-069).
enum FoodVerification {
  PRODUCER
  CHECKED
}

enum FoodProductSource {
  OFF
  CUSTOM
  CIQUAL
}

/// One food eaten, as the athlete logged it in SHARPIT (ADR-061). Nutrients are a snapshot taken
/// at logging, so a product refreshed later never rewrites a past day. The day's
/// `DailyNutrition` row (`provider: sharpit`) is recomputed from these entries on every change.
model FoodLogEntry {
  id        String         @id @default(cuid())
  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  /// Training day, stored at UTC midnight like DailyNutrition.date.
  date      DateTime
  meal      FoodMeal
  productId String?
  product   FoodProduct?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  brand     String?
  grams     Float
  kcal      Float
  protein   Float
  carbs     Float
  fat       Float
  fiber     Float?
  sugar     Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteId, date])
}

enum FoodMeal {
  BREAKFAST
  LUNCH
  DINNER
  SNACKS
}

model DailyNutrition {
  id         String         @id @default(cuid())
  athleteId  String
  athlete    AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  date       DateTime
  provider   String         @default("myfitnesspal")
  externalId String?

  calories      Int
  protein       Float
  carbohydrates Float
  fat           Float
  fiber         Float?
  sugar         Float?
  water         Float?

  meals    Json    @default("[]")
  complete Boolean @default(false)

  goalCalories      Int?
  goalProtein       Float?
  goalCarbohydrates Float?
  goalFat           Float?
  exerciseCalories  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([athleteId, date, provider])
  @@unique([athleteId, externalId])
  @@index([date])
  @@index([athleteId])
}

model RunMetrics {
  id         String   @id @default(cuid())
  activityId String   @unique
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  distanceM    Float?
  elevationM   Float?
  paceSecPerKm Float?
  avgHr        Int?
  avgPower     Float?
  cadence      Int?
  shoes        String?
}

model BikeMetrics {
  id         String   @id @default(cuid())
  activityId String   @unique
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  // Distance parcourue (m) — celle que Garmin/Strava résument ; les sorties plus anciennes
  // l'ont reprise de leur tracé (dernier point du flux distance).
  distanceM       Float?
  ftpPercent      Float?
  normalizedPower Float?
  intensityFactor Float?
  tss             Float?
  avgCadence      Int?
  avgPower        Float?
  elevationM      Float?
  calories        Int?
  bikeName        String?
}

model SwimMetrics {
  id         String   @id @default(cuid())
  activityId String   @unique
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  distanceM         Float?
  sets              Int?
  cssSecPer100m     Float?
  avgPaceSecPer100m Float?
  swolf             Float?
  drills            String?
}

model HikeTrip {
  id         String         @id @default(cuid())
  athleteId  String
  athlete    AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  activities Activity[]

  @@index([athleteId])
}

model HikeMetrics {
  id         String   @id @default(cuid())
  activityId String   @unique
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  distanceM      Float?
  elevationM     Float? // D+
  elevationLossM Float? // D−
  avgHr          Int?
  calories       Int?
  avgSpeedMps    Float?
}

model StrengthSet {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  exercise          String
  /// Matched exercises-dataset id (e.g. "0662") — set at sync/enrich when a visual is found.
  exerciseCatalogId String?
  sets              Int
  reps              Int
  durationSec       Int?
  weightKg          Float?
  rpe               Int?
  restSec           Int?
  videoUrl          String?
  notes             String?
  order             Int     @default(0)

  @@index([activityId])
  @@index([exerciseCatalogId])
}

model DailyHealth {
  id        String         @id @default(cuid())
  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  date      DateTime       @db.Date

  sleepMinutes  Int?
  napMinutes    Int? // sieste (Garmin napTimeSeconds, hors sommeil nocturne)
  hrv           Int?
  restingHr     Int?
  weightKg      Float?
  calories      Int?
  recoveryScore Int? // Garmin Training Readiness (0-100)
  stress        Int? // stress moyen sur la journée
  mood          String?

  // Sommeil détaillé (Garmin)
  sleepScore         Int? // score de sommeil Garmin (0-100)
  sleepDeepMin       Int? // sommeil profond (min)
  sleepLightMin      Int? // sommeil léger (min)
  sleepRemMin        Int? // sommeil paradoxal / REM (min)
  sleepAwakeMin      Int? // éveil pendant la nuit (min)
  sleepBedtimeMin    Int? // heure de coucher en minutes depuis minuit (heure locale)
  sleepWakeMin       Int? // heure de réveil en minutes depuis minuit (heure locale)
  sleepRespiration   Float? // respiration moyenne (resp/min)
  sleepAvgStress     Int? // stress moyen pendant le sommeil
  sleepScoreFeedback String? // code feedback qualité Garmin

  // Recovery (Garmin)
  readinessLevel    String? // LOW / MODERATE / HIGH ...
  readinessFeedback String? // code feedback court Garmin
  readinessFactors  Json? // détail des facteurs (sommeil, hrv, charge...)
  hrvStatus         String? // BALANCED / UNBALANCED_LOW / ...
  hrvBaselineLow    Int? // borne basse de la zone équilibrée
  hrvBaselineHigh   Int? // borne haute de la zone équilibrée
  bodyBattery       Int? // Body Battery actuel / plus récent (aligné Garmin Connect)
  totalSteps        Int? // pas quotidiens Garmin (mouvement de fond)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([athleteId, date])
  @@index([athleteId])
}

enum BodyCompositionSource {
