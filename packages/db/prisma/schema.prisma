  goal        Goal?              @relation(fields: [goalId], references: [id], onDelete: SetNull)
  raceDate    DateTime           @db.Date
  startDate   DateTime           @db.Date
  status      TrainingPlanStatus @default(ACTIVE)
  baselineCtl Int?
  summary     String?            @db.Text

  weeks PlanWeek[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([raceDate])
  @@index([athleteId])
}

model PlanWeek {
  id          String       @id @default(cuid())
  planId      String
  plan        TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  weekStart   DateTime     @db.Date
  weekIndex   Int
  phase       PlanPhase
  targetLoad  Int // TSS cible de la semaine
  targetHours Float?
  focus       String?
  isDeload    Boolean      @default(false)

  @@unique([planId, weekIndex])
  @@index([planId])
  @@index([weekStart])
}

model PhysicalNote {
  id              String           @id @default(cuid())
  athleteId       String
  athlete         AthleteProfile   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  category        PhysicalCategory @default(PAIN)
  status          PhysicalStatus   @default(ACTIVE)
  title           String // ex: "Tendinite genou droit"
  bodyPart        String? // ex: "Genou", "Bassin", "Pied"
  side            BodySide         @default(NA)
  severity        Int? // 0-10 (sévérité actuelle)
  description     String?
  affectsTraining Boolean          @default(true) // injecté dans le contexte coach
  /// What the athlete can still do, as last declared — drives the training strategy (ADR-068).
  functionalImpact FunctionalImpact?

  startDate  DateTime  @default(now())
  resolvedAt DateTime?

  checkins PhysicalCheckin[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([athleteId])
}

model PhysicalCheckin {
  id     String       @id @default(cuid())
  noteId String
  note   PhysicalNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  date     DateTime @default(now())
  severity Int? // 0-10 au moment du point de contrôle
  comment  String?
  /// What the athlete could still do at this point.
  functionalImpact FunctionalImpact?
  /// Set when this point records a status change (resolved, reopened…); null for a plain follow-up.
  status   PhysicalStatus?

  createdAt DateTime @default(now())

  @@index([noteId])
  @@index([date])
}

/// Persistent physical condition — core of the Physical Health Engine.
/// Never deleted. Resolved conditions remain in physiological history.
model Condition {
  id                    String          @id @default(cuid())
  athleteId             String
  athlete               AthleteProfile  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  scope                 ConditionScope
  type                  ConditionType
  bodyRegion            String
  side                  BodySide        @default(NA)
  label                 String
  diagnosis             String?
  status                ConditionStatus @default(NEW)
  severity              Float           @default(0)
  confidence            Float           @default(0.5)
  affectsTraining       Boolean         @default(true)
  startedAt             DateTime        @default(now())
  resolvedAt            DateTime?
  lastObservationAt     DateTime?
  recurrenceCount       Int             @default(0)
  observationCount      Int             @default(0)
  estimatedRecoveryDays Int?
  primaryTriggerManual  String?

  /// Idempotent link to legacy PhysicalNote during migration.
  legacyPhysicalNoteId String? @unique

  episodes             ConditionEpisode[]
  observations         ConditionObservation[]
  functionalCapacities FunctionalCapacity[]
  knowledge            ConditionKnowledge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([bodyRegion, side])
  @@index([athleteId])
}

model ConditionEpisode {
  id                    String        @id @default(cuid())
  conditionId           String
  condition             Condition     @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  episodeNumber         Int
  status                EpisodeStatus @default(ACTIVE)
  startedAt             DateTime
  resolvedAt            DateTime?
  peakSeverity          Float?
  estimatedRecoveryDays Int?
  triggerHypothesis     String?

  observations ConditionObservation[]

  @@unique([conditionId, episodeNumber])
  @@index([conditionId])
}

/// Point-in-time evidence. Never replaces condition state directly.
model ConditionObservation {
  id               String             @id @default(cuid())
  // Every other relation on this row is optional (SetNull) — it does not
  // reliably inherit a tenant from any parent, so it carries its own.
  athleteId        String
  athlete          AthleteProfile     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  conditionId      String?
  condition        Condition?         @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  episodeId        String?
  episode          ConditionEpisode?  @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  observedAt       DateTime           @default(now())
  context          ObservationContext
  source           ObservationSource  @default(ATHLETE)
  symptomPresent   Boolean
  severityReported Int?
  functionalImpact FunctionalImpact?
  bodyRegion       String
  side             BodySide           @default(NA)
  type             ConditionType
  comment          String?
  activityId       String?
  activity         Activity?          @relation(fields: [activityId], references: [id], onDelete: SetNull)
  plannedSessionId String?
  plannedSession   PlannedSession?    @relation(fields: [plannedSessionId], references: [id], onDelete: SetNull)
  trainingDayId    String?
  externalId       String?            @unique

  legacyPhysicalCheckinId String? @unique

  functionalCapacities FunctionalCapacity[]

  createdAt DateTime @default(now())

  @@index([conditionId, observedAt])
  @@index([activityId])
  @@index([plannedSessionId])
  @@index([observedAt])
  @@index([athleteId])
}

/// Functional capacity distinct from pain severity.
model FunctionalCapacity {
  id               String                @id @default(cuid())
  conditionId      String
  condition        Condition             @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  observationId    String?
  observation      ConditionObservation? @relation(fields: [observationId], references: [id], onDelete: SetNull)
  assessedAt       DateTime              @default(now())
  painSeverity     Int?
  trainingCapacity TrainingCapacityLevel
  comment          String?

  @@index([conditionId, assessedAt])
}

/// Personalized hypotheses — athlete-specific, never statistical population models.
model ConditionKnowledge {
  id             String                   @id @default(cuid())
  conditionId    String
  condition      Condition                @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  hypothesisType KnowledgeHypothesisType
  description    String
  confidence     KnowledgeConfidenceLevel @default(LOW)
  evidenceCount  Int                      @default(0)
  isInferred     Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([conditionId])
}

model DailyBriefing {
  id                String         @id @default(cuid())
  athleteId         String
  athlete           AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  date              DateTime       @db.Date
  content           String         @db.Text // bilan du jour en markdown généré par le coach IA
  readiness         Int? // readiness Garmin du jour au moment de la génération
  phaseAtGeneration String? // BriefingPhase bucket (morning|midday|afternoon|evening) at generation time — freshness detects phase drift
  generatedAt       DateTime       @default(now())

  @@unique([athleteId, date])
  @@index([date])
  @@index([athleteId])
}

model WeeklyReview {
  id          String         @id @default(cuid())
  athleteId   String
  athlete     AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  weekStart   DateTime       @db.Date // lundi de la semaine concernée
  content     String         @db.Text // rétro hebdo en markdown générée par le coach IA
  stats       Json? // statistiques de la semaine (volume, conformité, sommeil...)
  generatedAt DateTime       @default(now())

  @@unique([athleteId, weekStart])
  @@index([weekStart])
  @@index([athleteId])
}

model PerformanceRecord {
  id            String         @id @default(cuid())
  athleteId     String
  athlete       AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  group         String // "run" | "bike" | "swim" | "power" | "run-best" | "run-effort" | "bike-effort"
  category      String // clé unique du record, ex: "run-distance", "power-300", "run-best-5000"
  label         String
  rank          Int // 1 = meilleur (top 5)
  value         Float // valeur brute pour le tri/comparaison
  displayValue  String // valeur formatée pour l'affichage
  sublabel      String?
  activityId    String? // séance à l'origine du record (lien)
  activityDate  DateTime
  activityTitle String?
  createdAt     DateTime       @default(now())

  @@unique([athleteId, category, rank])
  @@index([group])
  @@index([athleteId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Observation Engine — primary store
// ─────────────────────────────────────────────────────────────────────────────
//
// All incoming data passes through the Observation Engine and lands here.
// Each row represents one normalized, validated observation.
//
// The `data` JSONB column holds the type-specific fields (everything not already
// captured by the indexed columns). Date fields inside `data` are stored as
// ISO-8601 strings and deserialized back by the repository.
//
// Legacy tables (Activity, DailyHealth, BodyCompositionMeasurement, PhysicalNote)
// remain active during the migration period. They will be removed once all
// read paths have been ported to consume Observation directly.

model Observation {
  id            String         @id // UUID assigned by the engine
  athleteId     String
  athlete       AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  type          String // ObservationType literal
  source        String // ObservationSource literal
  timestamp     DateTime // when the observation was physically recorded
  receivedAt    DateTime // when SHARPIT received it
  trainingDayId String // YYYY-MM-DD in athlete's timezone
  quality       String // ObservationQuality literal
  qualityFlags  Json           @default("[]") // QualityFlag[]
  normalizedAt  DateTime
  externalId    String? // garminId | stravaId | renphoId (for dedup)
  data          Json // type-specific fields (JSONB)

  createdAt DateTime @default(now())

  @@index([athleteId, type])
  @@index([athleteId, trainingDayId])
  @@index([athleteId, trainingDayId, type])
  @@index([type, externalId])
  @@index([timestamp])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature Extraction Layer — Feature Set store
// ─────────────────────────────────────────────────────────────────────────────
//
// Each row represents one computed (or pending) FeatureSetRecord.
// Categories: SESSION | LOAD | RECOVERY | BODY | CONDITION
//
// Scoping:
//   SESSION category  → sessionObsId is set (one record per session)
//   BODY category     → sessionObsId is set (reused for observationId)
//   All other cats    → trainingDayId is the scope key
//
// Versioning: version is monotonically increasing per (athleteId, category, scope).
// Old versions are retained for audit. Only the latest COMPUTED version is canonical.
//
// The data column holds the category-specific FeatureSet payload as JSONB.
// Confidence and algorithmId are also persisted for auditability.

model FeatureSet {
  id            String         @id // UUID assigned by FeatureEngine
  athleteId     String
  athlete       AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  category      String // 'SESSION' | 'LOAD' | 'RECOVERY' | 'BODY' | 'CONDITION'
  trainingDayId String? // YYYY-MM-DD (null only for legacy compat — always set in v1)
  sessionObsId  String? // Observation.id — set for SESSION and BODY categories
  version       Int            @default(1) // monotonically increasing
  status        String // 'PENDING' | 'COMPUTING' | 'COMPUTED' | 'INVALIDATED'
  confidence    Float
  algorithmId   String // e.g. 'session-features-v1'
  data          Json // FeatureSet payload
  sourceObsIds  String[]       @default([]) // Observation IDs that contributed
  computedAt    DateTime?
  createdAt     DateTime       @default(now())

  @@index([athleteId, category, trainingDayId])
  @@index([athleteId, category, sessionObsId])
  @@index([athleteId, trainingDayId])
  @@index([athleteId, status])
  @@index([sessionObsId])
}

// ─────────────────────────────────────────────────────────────────────────────
// INFERENCE LAYER — Digital Twin + Decision Records
// ─────────────────────────────────────────────────────────────────────────────

/**
 * One Digital Twin per athlete.
 * Mutable — updated in place by the Inference Orchestrator after each model run.
 * The `recoveryState` column stores the complete RecoveryState JSON.
 * Future models add new nullable columns (e.g. fatigueState) without
 * touching existing data.
 */
model DigitalTwin {
  id                       String         @id @default(cuid())
  athleteId                String         @unique
  athlete                  AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  recoveryState            Json? // RecoveryState | null
  fatigueState             Json? // FatigueState | null  (Fatigue Intelligence v1)
  adaptationState          Json? // AdaptationState | null  (Adaptation Intelligence v1)
  reasoningState           Json? // ReasoningState | null   (Reasoning Engine v1)
  physicalHealthState      Json? // PhysicalHealthState | null (Physical Health v1)
  environmentalStressState Json? // EnvironmentalStress | null (Environment v1.1)
  environmentalImpactState Json? // EnvironmentalImpact | null (Environment v1.1)
  environmentalStateMeta   Json? // EnvironmentalStateMeta | null (rebuild metadata)
  updatedAt                DateTime       @updatedAt
  createdAt                DateTime       @default(now())

  @@index([athleteId])
}

/// Immutable environmental evidence — source of truth for environmental inference.
/// Twin environmental columns are a rebuildable cache derived from these records.
model EnvironmentalObservationRecord {
  id               String         @id
  recordVersion    String
  athleteId        String
  athlete          AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  dimension        String
  payload          Json
  observedAt       DateTime
  receivedAt       DateTime
  ingestedAt       DateTime
  trainingDayId    String?
  temporalScope    String
  intervalStart    DateTime?
  intervalEnd      DateTime?
  exposure         String
  location         Json
  source           String
  providerId       String?
  externalId       String?
  providerSnapshot Json
  fieldQuality     Json
  aggregateQuality String
  confidence       Float
  supersededBy     String?

  @@index([athleteId, trainingDayId])
  @@index([athleteId, observedAt])
  @@index([supersededBy])
}

/**
 * Immutable audit trail of every inference pass.
 * Created when any model runs — never updated, never deleted.
 * Stores the complete inference snapshot (signals, state update, decision,
 * recommendation, explanation) for auditability and historical replay.
 * Per ADR-004: ephemeral Signals are embedded here, NOT persisted independently.
 */
model DecisionRecord {
  id             String         @id
  athleteId      String
  athlete        AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  trainingDayId  String
  modelId        String // 'recovery-synthesis-v1'
  modelVersion   String // 'v1'
  confidence     Float
  signals        Json // { autonomicBalance, sleepAdequacy, ... }
  stateUpdate    Json // the RecoveryState written to Digital Twin
  decision       Json // { verdict, recommendedIntensity, rationale }
  recommendation Json // { type, title, summary, keyEvidence }
  explanation    String // human-readable explanation text
  inputSummary   Json // key feature values used for audit/replay
  computedAt     DateTime
  createdAt      DateTime       @default(now())

  @@index([athleteId, trainingDayId])
  @@index([athleteId, modelId])
  @@index([computedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Decision Memory — see docs/adr/ADR-006-decision-memory-aggregate.md
//
// A separate aggregate from DecisionRecord (per-engine-run inference audit).
// CoachingDecision tracks one LLM-proposed, Gate-validated session from the
// moment it's shown to the athlete through to its retrospective outcome.
// snapshotContext embeds a frozen copy of AthleteSnapshot/DecisionState at
// recommendation time — AthleteSnapshotRecord is upserted per day and cannot
// be safely referenced by id after the fact (see ADR-006).
// ─────────────────────────────────────────────────────────────────────────────

enum CoachingDecisionSource {
  PLAN_GENERATOR
  PLAN_ADAPTER
}

enum CoachingDecisionStatus {
  PRESENTED
  ACCEPTED
  MODIFIED
  REJECTED
  EXPIRED
}

enum CoachingDecisionActionType {
  ACCEPTED
  MODIFIED
  REJECTED
  OVERRIDDEN
}

enum CoachingDecisionActionSource {
  PLAN_REVIEW_UI
  CALENDAR_EDIT
  BATCH_EXPIRY
}

enum CoachingOutcomeStatus {
  EVALUATED
  INCONCLUSIVE
}

/// Immutable recommendation snapshot: the exact LLM proposal + Gate verdict + physiological
/// context at the moment it was shown to the athlete. Never updated after insert.
model CoachingDecision {
  id            String                 @id @default(cuid())
  athleteId     String
  athlete       AthleteProfile         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  trainingDayId String
  source        CoachingDecisionSource
  status        CoachingDecisionStatus @default(PRESENTED)

  /// The exact GateProposal as generated — never mutated after insert.
  proposal                   Json
  /// The exact GateSessionResult (status, findings, requiredAssumptions, saferAlternative) — verbatim.
  gateResult                 Json
  /// Frozen subset of AthleteSnapshot/DecisionState at recommendation time (see ADR-006).
  snapshotContext            Json
  /// Best-effort cross-reference only — AthleteSnapshotRecord is upserted, not append-only.
  /// Never treated as a foreign key or relied on for correctness.
  snapshotIdAtRecommendation String?

  createdAt DateTime @default(now())

  actions CoachingDecisionAction[]
  outcome CoachingDecisionOutcome?

  @@index([athleteId, trainingDayId])
  @@index([status])
}

/// Append-only log of what the athlete did with a recommendation. A single decision can
/// accumulate more than one action over time (e.g. ACCEPTED, then OVERRIDDEN weeks later).
model CoachingDecisionAction {
  id         String           @id @default(cuid())
  decisionId String
  decision   CoachingDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  actionType CoachingDecisionActionType
  occurredAt DateTime                     @default(now())
  source     CoachingDecisionActionSource
  rationale  String?

  /// Set when the action created or touched a PlannedSession.
  resultingPlannedSessionId String?

  @@index([decisionId])
  @@index([resultingPlannedSessionId])
}

/// Retrospective evaluation of a decision, computed once evidence has had time to accumulate.
/// One row per decision — outcomeStatus is EVALUATED only when there's enough evidence to say
/// something; otherwise INCONCLUSIVE. Never a bare success/quality score.
model CoachingDecisionOutcome {
  id         String           @id @default(cuid())
  decisionId String           @unique
  decision   CoachingDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  evaluatedAt   DateTime              @default(now())
  outcomeStatus CoachingOutcomeStatus

  /// Planned vs. actual duration/load/intensity — reuses the existing SessionAnalysis shape.
  executionMatch            Json?
  /// RPE, feeling, pain — from the linked Activity + any ConditionObservation.
  subjectiveResponse        Json?
  /// 24-72h readiness/fatigue delta — only populated when the underlying snapshots exist.
  shortTermRecoveryResponse Json?
  /// New or worsening physical-health condition linked to this session.
  safetySignal              Json?

  /// Explicit caveats — always populated, even when EVALUATED.
  limitations String[]
  /// 0-1, a deterministic function of evidence completeness — not a model output.
  confidence  Float

  @@index([decisionId])
}

/**
 * Latest Athlete Snapshot per training day — canonical product state.
 * Each regeneration replaces the row; snapshotId fingerprints inputs for idempotency.
 */
model AthleteSnapshotRecord {
  id            String         @id @default(cuid())
  athleteId     String
  athlete       AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  trainingDayId String
  snapshotId    String
  payload       Json
  generatedAt   DateTime
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([athleteId, trainingDayId])
  @@index([snapshotId])
  @@index([generatedAt])
}

model Conversation {
  id        String         @id @default(cuid())
  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  title     String         @default("Nouvelle conversation")
  // Historique complet des messages UI (UIMessage[] du AI SDK), sérialisé en JSON.
  messages  Json           @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
  @@index([athleteId])
}

model PlannedSession {
  id                    String            @id @default(cuid())
  athleteId             String
  athlete               AthleteProfile    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  type                  ActivityType
  date                  DateTime          @db.Date
  startTime             String? // heure de début planifiée "HH:mm" (locale) — choisie pour caser la séance dans l'agenda Google
  title                 String?
  description           String?
  /// Structured strength prescription (sets/reps) — STRENGTH only. Not an engine output.
  strengthPrescription  Json?
  /// Structured endurance prescription (steps/targets) — RUN/BIKE/SWIM. Not an engine output.
  /// Targets are stored relative to athlete thresholds and resolved at push time.
  endurancePrescription Json?
  /// Session-specific accessories (EquipmentItemId[]) — athlete prep checklist.
  accessories           Json?
  durationMin           Int? // durée prévue en minutes
  load                  Float? // charge / TSS prévue
  intensity             SessionIntensity?
  completed             Boolean           @default(false)
  /// One of the week's two or three sessions that matter most (key-sessions.ts). A week with
  /// none marked counts every session as key — the plans made before the flag existed.
  isKey                 Boolean           @default(false)

  /// Contextual intention — athlete-declared (not engine output).
  exposureSetting      String? // INDOOR | OUTDOOR | UNKNOWN
  locationLabel        String?
  locationLat          Float?
  locationLng          Float?
  locationType         String? // ROAD | TRAIL | TRAINER | POOL | GYM | TRACK | UNKNOWN
  /// Cached PlannedSessionContext projection (engine outputs + advisories).
  environmentContext   Json?
  environmentContextAt DateTime?

  goalId String?
  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)

  // Brick / multisport : les jambes d'un même enchaînement (ex. vélo→course)
  // partagent un brickGroupId. brickOrder donne l'ordre des jambes (0 = première).
  // Chaque jambe reste une séance autonome (un sport, une activité liée, une analyse).
  brickGroupId String?
  brickOrder   Int?

  // Réalisation : activité Strava/Garmin liée + analyse IA prévu vs réalisé
  activityId            String?                @unique
  activity              Activity?              @relation(fields: [activityId], references: [id], onDelete: SetNull)
  analysis              Json? // { complianceScore, verdict, summary, remarks[], recommendation }
  analyzedAt            DateTime?
  conditionObservations ConditionObservation[]

  // Lien vers l'événement créé dans Google Calendar (calendrier SPORT)
  googleEventId String? @unique

  /// Dernier workout Garmin Connect poussé depuis cette séance (anti-spam + statut montre).
  garminWorkoutId            String?
  garminWorkoutScheduledDate String? // YYYY-MM-DD
  garminWorkoutPushedAt      DateTime?
  /// Seuils athlète utilisés pour résoudre les cibles envoyées — sert à détecter
  /// qu'une séance déjà envoyée est périmée parce que les seuils ont bougé depuis.
  garminWorkoutThresholds    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([brickGroupId])
  @@index([athleteId])
}

enum CoachMemorySource {
  USER
  COACH
}

enum TravelTrainingConstraint {
  FULL
  REDUCED
  MOBILITY_ONLY
  NONE
}

enum TravelDiscipline {
  RUN
  BIKE
  SWIM
  STRENGTH
  MOBILITY
}

/// TRAVEL = away-from-home period (has a location). CONSTRAINT = temporary
/// training-capacity limitation not tied to travel — illness, injury, high
/// work-stress week, etc. (no location).
enum AthleteMemoryEntryType {
  TRAVEL
  CONSTRAINT
}

/// Despite the name, this table now hosts two kinds of entries (see `type`):
/// TRAVEL (location required) and CONSTRAINT (no location). Kept the original
/// name rather than a broad rename — internal-only, no user-facing cost, and
/// renaming would touch every call site for zero functional benefit.
model AthleteTravelContext {
  id                 String                   @id @default(cuid())
  athleteId          String
  athlete            AthleteProfile           @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  type               AthleteMemoryEntryType   @default(TRAVEL)
  label              String?
  locationLabel      String?
  locationLat        Float?
  locationLng        Float?
  startDate          DateTime                 @db.Date
  endDate            DateTime                 @db.Date
  note               String?
  /// How much structured training is realistic during this period.
  trainingConstraint TravelTrainingConstraint @default(FULL)
  /// Empty = all disciplines allowed. Otherwise only these may be planned.
  allowedDisciplines TravelDiscipline[]       @default([])
  source             CoachMemorySource        @default(USER)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([startDate, endDate])
  @@index([type])
  @@index([athleteId])
}

/// Subjective day journal (signals, mood chip, hydration, caffeine) — one row per athlete training day.
/// App-layer persistence for future stats; not Core Gate input yet.
model AthleteDayJournal {
  id            String         @id @default(cuid())
  athleteId     String
  athlete       AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD in athlete timezone (training day id).
  trainingDayId String
  /// Factor map: { coffee?: 'yes'|'no'|'unset', sick?: ..., ... }
  factors       Json           @default("{}")
  moodLabel     String?
  hydrationMl   Int?
  caffeineMg    Int?
  /// Minutes spent driving that day — sitting still, often tense; the coach reads it.
  drivingMinutes Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([athleteId, trainingDayId])
  @@index([athleteId, trainingDayId])
}

enum JournalHabitExperimentIntent {
  /// « Supprimer » : a held day records the factor as 'no'.
  REMOVE
  /// « Ajouter » : a held day records the factor as 'yes'.
  ADD
}

/// 7-day journal habit experiment (ADR-032). Only intent + window are stored:
/// progress, review date and verdict are derived at read time from the journal
/// and DailyHealth, with the same method as habit associations.
model JournalHabitExperiment {
  id          String                       @id @default(cuid())
  athleteId   String
  athlete     AthleteProfile               @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  /// Built-in or custom_* journal factor id, validated server-side.
  factorId    String
  intent      JournalHabitExperimentIntent
  /// First training day of the window (YYYY-MM-DD, same key as AthleteDayJournal).
  startDayId  String
  cancelledAt DateTime?
  createdAt   DateTime                     @default(now())

  @@index([athleteId, startDayId])
}

/// Current longer-lived activity mode (Actif / En pause / Blessé / Malade).
model AthleteActivityStatus {
  id            String         @id @default(cuid())
  athleteId     String         @unique
  athlete       AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  /// active | paused | injured | sick
  status        String         @default("active")
  /// until_modified | until_date
  retentionKind String         @default("until_modified")
  untilDate     DateTime?      @db.Date
  travelId      String?
  updatedAt     DateTime       @updatedAt
  createdAt     DateTime       @default(now())
}

/// Closed/open periods of activity status — source of truth for future stats.
model AthleteActivityStatusHistory {
  id            String         @id @default(cuid())
  athleteId     String
  athlete       AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  status        String
  retentionKind String
  untilDate     DateTime?      @db.Date
  travelId      String?
  startedAt     DateTime
  /// Null while this period is the current open one.
  endedAt       DateTime?
  createdAt     DateTime       @default(now())

  @@index([athleteId, startedAt])
  @@index([athleteId, endedAt])
}

// Analyse globale d'un brick (enchaînement multisport) : agrège les jambes
// pour évaluer transitions, dérive cardiaque vélo→course et gestion d'ensemble.
// Une analyse par brickGroupId (les jambes gardent par ailleurs leur analyse
// individuelle dans PlannedSession.analysis).
model BrickAnalysis {
  brickGroupId String         @id
  athleteId    String
  athlete      AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  content      Json // { overallScore, summary, transition, remarks[], recommendation }
  generatedAt  DateTime       @default(now())

  @@index([athleteId])
}

/// The athlete's own verdict on a whole brick, once every leg is done (ADR-059).
/// Each leg keeps its own RPE and feeling on Activity; this one rates the
/// chain as a single effort, transitions included. One per brickGroupId.
model BrickEvaluation {
  brickGroupId     String         @id
  athleteId        String
  athlete          AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  rpe              Int? // 1–10, Foster CR10, whole brick
  transitionRating Int? // 1–5, how the transitions went
  feeling          String? // ACTIVITY_FEELING_SCALE label
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([athleteId])
}

/// One coach analysis run per target (ADR-036).
/// Makes background work visible: the client learns an analysis is running, and
/// gets told when it is ready, from any page. Never read by Core.
model AnalysisRun {
  id        String              @id @default(cuid())
  athleteId String
  athlete   AthleteProfile      @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  kind      AnalysisKind
  /// Activity id, planned-session id, brick group id, or the week start (yyyy-MM-dd).
  targetId  String
  status    AnalysisRunStatus   @default(RUNNING)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// Short reason kept for the athlete-facing failure toast.
  error      String?

  @@unique([athleteId, kind, targetId])
  @@index([athleteId, finishedAt])
  @@index([athleteId, status])
}

enum AnalysisKind {
  ACTIVITY_NARRATIVE
  SESSION_COMPLIANCE
  BRICK
  WEEKLY_REVIEW
}

enum AnalysisRunStatus {
  RUNNING
  READY
  FAILED
}

/// Science Sport reliability V0 — athlete-isolated A/B evidence for deterministic recalc.
/// Retention LOCKED: last 5 OR 14 days (see ANALYSIS_EVIDENCE_RETENTION).
/// Cascade on AthleteProfile delete; purgeAnalysisEvidenceForAthlete on soft-delete / health or AI consent withdraw.
model AnalysisEvidenceSnapshot {
  id            String         @id @default(cuid())
  athleteId     String
  athlete       AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  trainingDayId String
  /// Best-effort cross-ref to AthleteSnapshotRecord.snapshotId (upserted, not append-only).
  snapshotId    String?
  /// Deterministic pack inputs used for the verdict (PackInputSignals + gaps).
  inputs        Json
  /// Deterministic verdict snapshot (overallVerdict, packTier, rationaleCodes, …).
  verdict       Json
  createdAt     DateTime       @default(now())

  @@index([athleteId, createdAt])
  @@index([athleteId, trainingDayId, createdAt])
}

/// Per-call AI token usage, for cost visibility — not an enforcement mechanism.
/// Frequency is capped separately by the rate limiters (see src/lib/rate-limit.ts);
/// this table exists so real spend-per-athlete can be queried directly.
model AiUsageEvent {
  id           String         @id @default(cuid())
  athleteId    String
  athlete      AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  feature      String // 'coach' | 'analysis'
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  createdAt    DateTime       @default(now())

  @@index([athleteId, createdAt])
}
