{
  "name": "@sharpit/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3001",
    "build": "prisma generate && next build",
    "db:migrate:deploy": "tsx scripts/repair-failed-migrations.ts && prisma migrate deploy",
    "start": "next start -p 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:clean:activities": "tsx scripts/clean-activities.ts",
    "db:backfill:narratives": "tsx scripts/backfill-activity-narratives.ts",
    "db:backfill:session-observations": "tsx scripts/backfill-session-observations.ts",
    "db:backfill:body-composition-observations": "tsx scripts/backfill-body-composition-observations.ts",
    "db:recompute:fuel-features": "tsx scripts/recompute-fuel-features.ts",
    "db:recompute:session-features": "tsx scripts/recompute-session-features.ts",
    "db:evaluate-decision-outcomes": "tsx scripts/evaluate-decision-outcomes.ts",
    "db:migrate:physical-health": "tsx scripts/migrate-physical-health-phase1.ts",
    "db:studio": "prisma studio",
    "db:up": "docker compose up -d",
    "db:migrate-neon": "bash scripts/migrate-to-neon.sh",
    "garmin:login": "python3 scripts/garmin-login.py",
    "garmin:import-tokens": "tsx scripts/import-garmin-tokens.ts",
    "smoke:must-private": "tsx scripts/smoke-must-private.ts",
    "smoke:api-host": "tsx scripts/smoke-api-host.ts",
    "bench:coach-models": "tsx --env-file=.env scripts/bench-coach-models.ts",
    "eval:coach-memory": "tsx scripts/eval-coach-memory.ts",
    "data:ciqual": "tsx scripts/build-ciqual-foods.ts",
    "data:coach-knowledge": "tsx scripts/build-coach-knowledge-index.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.9",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^11.1.0",
    "@sharpit/app": "workspace:*",
    "@sharpit/db": "workspace:*",
    "@sharpit/server": "workspace:*",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@sharpit/eslint-config": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^19",
    "dotenv": "^16.4.7",
    "eslint": "^9",
    "prisma": "^6.19.3",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
