{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack enable && HUSKY=0 yarn install --immutable",
  "buildCommand": "yarn db:migrate:deploy && yarn build",
  "ignoreCommand": "node ../../scripts/ci/vercel-ignore-build.mjs --app api",
  "git": {
    "deploymentEnabled": false
  },
  "github": {
    "autoJobCancelation": true
  },
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/sync",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/sync",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/planned-forecast",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/demo-reseed",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/morning-push",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/beta-report",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/privacy-purge",
      "schedule": "15 3 * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/morning-push/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/sync/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/demo-reseed/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/planned-forecast/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/renpho/sync/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/withings/sync/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/myfitnesspal/sync/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/garmin/connect/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/coach/adapt/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/coach/plan/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/v1/myfitnesspal/sync/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/v1/myfitnesspal/connect/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/myfitnesspal/connect/route.ts": {
      "maxDuration": 300
    }
  }
}
