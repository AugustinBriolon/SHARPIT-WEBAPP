# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Database (Postgres, Prisma 6) ---
DATABASE_URL="postgresql://user:password@localhost:5432/sharpit"
# Set to "true" only when running behind Neon's serverless driver adapter.
PRISMA_NEON_ADAPTER=

# --- api. origin (ADR-048 phase 3) ---
# Where the web reads and writes: the browser and the server components call it with a Clerk
# Bearer. Production: https://api.sharpit.app. Local: the api app (`yarn dev` runs it on 3001).
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001

# --- Public origin (ADR-040) ---
# Canonical origin for absolute links handed to the iOS app (Today empty state,
# Garmin handoff). Production: https://sharpit.app. Unset locally = request origin.
NEXT_PUBLIC_APP_URL=
# SharpIt Pro via StoreKit 2 (ADR-044). The app's numeric Apple ID (App Store
# Connect → App Information) — required to verify production transactions.
APPLE_APP_APPLE_ID=
# Defaults to app.sharpit.ios.
APPLE_IAP_BUNDLE_ID=
# Apple Developer Team ID for /.well-known/apple-app-site-association (iOS
# Associated Domains). Set in Vercel at cutover; read at build time.
APPLE_TEAM_ID=

# --- Apple Push Notification service (APNs) ---
# For morning verdict push to the native iOS app (SHARPIT-APP).
# Key ID (10 chars), Team ID (10 chars), and p8 private key contents (or base64).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=app.sharpit.ios
APNS_PRODUCTION=

# --- Clerk (auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- AI coach ---
AI_GATEWAY_API_KEY=
COACH_MODEL=
FEATURE_ENGINE_ENABLED=

# --- Langfuse (LLM observability — optional; Coach traces when both keys are set) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU default. US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Secrets / crypto ---
# Required in production to encrypt stored provider tokens (src/lib/secret-box.ts).
# Falls back to CRON_SECRET/DATABASE_URL in local dev only — never in production.
SECRET_ENCRYPTION_KEY=
# AES-128 key (exactly 16 UTF-8 bytes) for Renpho cloud API request/response bodies
# (packages/server/.../renpho.ts). Required whenever Renpho sync runs — fail closed if unset.
RENPHO_ENCRYPTION_SECRET=

# --- Cron (Vercel Scheduled Functions) ---
# Long random value; every src/app/api/cron/*/route.ts request must present
# `Authorization: Bearer $CRON_SECRET`. Requests are rejected if this is unset.
CRON_SECRET=

# --- Rate limiting (Upstash Redis) ---
# Required in production for coach / sync / AI routes (those fail closed if unset).
# The global apiGeneral flood backstop still fails open so a Redis blip cannot
# take the whole app down. Set both URL and TOKEN (already used in Vercel prod).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin ---
# Comma-separated list of Clerk account emails allowed on /admin and /api/admin/*
# and the /api/dev/* developer tools.
ADMIN_EMAILS=

# --- Dev-only ---
DEV_TOOLS_ENABLED=false
# Allows POST /api/dev/replay mode=write in production (destructive). Keep false.
DEV_TOOLS_WRITE=false
DEV_BYPASS_CLERK=false
NEXT_PUBLIC_DEV_BYPASS_CLERK=false
DEV_LAN_HOST=

# --- Provider OAuth integrations ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=

WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REDIRECT_URI=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Misc ---
TZ=

# Transactional e-mail (Resend) — optional; without a key no e-mail is sent (account deletion
# confirmation). The sender's domain must be verified at Resend.
RESEND_API_KEY=
EMAIL_FROM="SharpIt <noreply@sharpit.app>"
